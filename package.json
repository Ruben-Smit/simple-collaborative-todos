{
  "name": "simple-collaborative-todos",
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite dev --open",
    "dev:static": "BUILD_MODE=static vite dev",
    "build": "BUILD_MODE=cloudflare vite build",
    "build:cloudflare": "BUILD_MODE=cloudflare vite build",
    "build:node": "BUILD_MODE=node vite build",
    "build:static": "BUILD_MODE=static vite build",
    "build:dependabot-staging": "BUILD_MODE=cloudflare vite build",
    "preview": "vite preview",
    "preview:node": "BUILD_MODE=node vite preview",
    "preview:static": "BUILD_MODE=static vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "@sveltejs/adapter-cloudflare": "^4.7.4",
    "@sveltejs/adapter-node": "^5.2.2",
    "@sveltejs/adapter-static": "^3.0.4",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tailwindcss/forms": "^0.5.9",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.6",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "vite": "^8.2.1",
    "wrangler": "^3.78.6"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.12.0",
    "better-sqlite3": "^11.8.1",
    "cycle": "^1.0.3",
    "drizzle-orm": "^0.33.0",
    "lodash-es": "^4.17.21",
    "nanostores": "^0.10.0"
  }
}
